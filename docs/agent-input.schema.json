{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DODO Workbench Agent candidates v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "expected_revision", "findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "findings": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "metric", "current", "prior"],
      "properties": {
        "id": {"type": "string"}, "label": {"type": "string"}, "metric": {"type": "string"},
        "current": {"$ref": "#/$defs/input"}, "prior": {"$ref": "#/$defs/input"}
      }
    }}
  },
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "page", "quote", "value", "unit", "currency", "entity", "scope", "period_start", "period_end", "period_type"],
      "properties": {
        "document_id": {"type": "string"},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "quote": {"type": "string"},
        "value": {"type": ["string", "null"], "pattern": "^-?\\d{1,40}(?:\\.\\d{1,16})?$"},
        "unit": {"enum": ["元", "万元", "亿元", ""]},
        "currency": {"type": "string"}, "entity": {"type": "string"}, "scope": {"type": "string"},
        "period_start": {"type": "string"}, "period_end": {"type": "string"},
        "period_type": {"enum": ["flow", "instant", ""]}
      }
    }
  }
}
